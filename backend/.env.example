# Backend Environment Configuration Template
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Neon or Self-Hosted)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (Must be at least 32 characters long)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_min_32_characters_here
JWT_EXPIRES_IN=24h

# Rwanda WhatsApp Business Phone
WHATSAPP_BUSINESS_PHONE=+250700000000

# Standard Delivery Fee in Rwandan Francs (RWF)
DELIVERY_FEE_RWF=1500

# Allowed CORS client origin (or * for development)
CLIENT_ORIGIN=*

# Initial Admin Account Provisioning
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here
ADMIN_FULL_NAME=Your Admin Name
ADMIN_PHONE=+250700000000
